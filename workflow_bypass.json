{
  "id": "bypass-workflow-123",
  "name": "Bypass N8N Chatbot",
  "nodes": [
    {
      "parameters": {
        "public": true,
        "options": {}
      },
      "id": "trigger-chat-1",
      "name": "When chat message received",
      "type": "@n8n/n8n-nodes-langchain.chatTrigger",
      "typeVersion": 1.1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/api/chat",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"message\": \"{{ $json.chatInput }}\",\n  \"sessionId\": \"{{ $json.sessionId }}\"\n}",
        "options": {}
      },
      "id": "http-request-1",
      "name": "Kirim ke Backend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "b1b1b1b1-b1b1-b1b1-b1b1-b1b1b1b1b1b1",
              "name": "output",
              "value": "={{ $json.response }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "set-output-1",
      "name": "Format Jawaban",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.3,
      "position": [440, 0]
    }
  ],
  "connections": {
    "When chat message received": {
      "main": [
        [
          {
            "node": "Kirim ke Backend",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Kirim ke Backend": {
      "main": [
        [
          {
            "node": "Format Jawaban",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": true
}
